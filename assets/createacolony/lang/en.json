	"quest-k-door": "A door",
	"quest-k-door-desc": "Make a door for your house.",
	"chapter-carpentry": "Carpentry and building",
	"quest-k-anvil": "An anvil",
	"quest-k-anvil-desc": "Cast an anvil.",
	"quest-k-hammer": "A hammer",
	"quest-k-hammer-desc": "Make a metal hammer.",
	"quest-k-ingots": "Sixteen ingots",
	"quest-k-ingots-desc": "Sixteen ingots of any metal.",
	"chapter-smithing": "Smithing",
	"quest-k-flax": "Flax",
	"quest-k-flax-desc": "Harvest flax fibres.",
	"quest-k-twine": "Twine",
	"quest-k-twine-desc": "Twist fibres into twine.",
	"quest-k-linen": "Linen",
	"quest-k-linen-desc": "Weave linen.",
	"chapter-textiles": "Textiles",
	"quest-k-hides": "Hides",
	"quest-k-hides-desc": "Skin four hides.",
	"quest-k-leather": "Leather",
