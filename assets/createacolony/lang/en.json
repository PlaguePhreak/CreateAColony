	"item-handbooktitle-createacolony:corpsecompass": "Usage",
	"item-handbooktext-createacolony:corpsecompass": "Right-click to point at your nearest corpse, or a settler's corpse from your colony. It also works in the off hand.<br/><br/>Searches 7x7 chunks around you.",
	"corpsecompass-corpses-not-found": "No corpses nearby.",
