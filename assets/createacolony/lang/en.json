	"quest-k-spear-desc": "Knap a spear head and haft it.",
	"quest-k-arrows": "Arrowheads",
	"quest-k-arrows-desc": "Knap eight arrowheads and fletch them.",
	"chapter-knapping": "Knapping",
	"quest-k-planks": "Planks",
	"quest-k-planks-desc": "Saw thirty-two planks.",
	"quest-k-chest": "A chest",
