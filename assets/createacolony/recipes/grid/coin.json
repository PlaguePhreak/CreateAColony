// Striking colony coins: a copper ingot and a hammer make 10 copper coins. The Royal Mint's minter makes them
// (its Crafting recipes tab), and players can strike them by hand too.
[
	{
		"ingredientPattern": "HI",
		"ingredients": {
			"H": { "type": "item", "code": "game:hammer-*", "isTool": true },
			"I": { "type": "item", "code": "game:ingot-copper" }
		},
		"width": 2,
		"height": 1,
		"shapeless": true,
		"output": { "type": "item", "code": "createacolony:coin-copper", "quantity": 10 }
	}
]
