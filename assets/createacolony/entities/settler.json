{
	"code": "settler",
	"class": "EntitySettler",
	"variantGroups": [{ "code": "sex", "states": ["male", "female"] }],
	"canClimb": true,
	"eyeHeight": 1.6,
	"hitboxSize": { "x": 0.6, "y": 1.85 },
	"deadHitboxSize": { "x": 0.75, "y": 0.5 },
	"attributes": {
		"outfitConfigFileName": "game:villageraccessories-{sex}"
	},
	"client": {
		"renderer": "Shape",
		// Humanoid model from VS Village (MIT), see THIRD_PARTY_NOTICES.md. Uses vanilla skin textures.
		"shape": { "base": "createacolony:entity/humanoid/settler-{sex}" },
		"behaviors": [
			{ "code": "villagerinventory" },
			{ "code": "nametag", "showtagonlywhentargeted": true },
			{ "code": "repulseagents" },
			{ "code": "controlledphysics", "stepHeight": 1.1 },
			{ "code": "interpolateposition" }
		],
		"animations": [
			{ "code": "idle", "animation": "balanced-idle", "blendMode": "average", "triggeredBy": { "defaultAnim": true } },
			{ "code": "walk", "animation": "balanced-walk", "blendMode": "average" },
			{ "code": "sleep", "animation": "balanced-lie", "blendMode": "average", "weight": 10 },
			{ "code": "shelter", "animation": "balanced-sitfloor", "blendMode": "average", "weight": 10 },
			{ "code": "eat", "animation": "balanced-holdbelly-idle", "blendMode": "average", "weight": 5 },
			{ "code": "build", "animation": "balanced-hit", "blendMode": "average", "weight": 5 },
			{ "code": "die", "animation": "balanced-die", "animationSpeed": 1.75, "weight": 10, "blendMode": "addAverage" },
			{ "code": "hurt", "animation": "balanced-hurt", "animationSpeed": 2, "blendMode": "addAverage" }
		]
	},
	"server": {
		"behaviors": [
			{ "code": "villagerinventory" },
			{ "code": "nametag", "showtagonlywhentargeted": true },
			{ "code": "repulseagents" },
			{ "code": "controlledphysics", "stepHeight": 1.1 },
			{ "code": "health", "currenthealth": 20, "maxhealth": 20 },
			{ "code": "colonycitizen" },
			{ "code": "settlerneeds" },
			{
				"code": "taskai",
				"aitasks": [
					// Highest priority wins. Job work sits between eating and wandering; each job task only runs for its own job.
					{ "code": "settlershelter", "animation": "walk", "priority": 3.0, "movespeed": 0.025 },
					{ "code": "settlersleep", "animation": "walk", "priority": 2.0, "movespeed": 0.018 },
					{ "code": "settlereat", "animation": "walk", "priority": 1.5, "movespeed": 0.02 },
					{ "code": "settlercourier", "animation": "walk", "priority": 1.2, "movespeed": 0.022 },
					{ "code": "settlerbuilder", "animation": "walk", "priority": 1.2, "movespeed": 0.02 },
					{ "code": "settlerforester", "animation": "walk", "priority": 1.2, "movespeed": 0.02 },
					{ "code": "settlerfarmer", "animation": "walk", "priority": 1.2, "movespeed": 0.02 },
					{ "code": "settlerpotter", "animation": "walk", "priority": 1.2, "movespeed": 0.02 },
					{ "code": "settlercook", "animation": "walk", "priority": 1.2, "movespeed": 0.02 },
					{ "code": "settlerguard", "animation": "walk", "priority": 1.2, "movespeed": 0.024 },
					{ "code": "settlervisitor", "animation": "walk", "priority": 1.1, "movespeed": 0.02 },
					{ "code": "wander", "priority": 1.0, "movespeed": 0.012, "animation": "walk", "maxDistanceToSpawn": 12, "wanderRangeMin": 3, "wanderRangeMax": 10 },
					{ "code": "lookaround", "priority": 0.5 }
				]
			}
		]
	},
	"sounds": {}
}
