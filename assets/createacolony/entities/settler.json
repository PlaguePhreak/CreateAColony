{
	"code": "settler",
	"class": "EntitySettler",
	"variantGroups": [{ "code": "sex", "states": ["male", "female"] }],
	"canClimb": true,
	"eyeHeight": 1.6,
	"hitboxSize": { "x": 0.6, "y": 1.85 },
	"deadHitboxSize": { "x": 0.75, "y": 0.5 },
	// SettlerLooks (src/Settlers/SettlerLooks.cs) copies the player's model, textures and skin parts
	// (the player character creator) in here when the game loads, and adds the "extraskinnable" behavior.
	// What is written below is only the fallback if the player's entity cannot be read.
	"attributes": {
		"mainTextureCode": "skin1"
	},
	"client": {
		"renderer": "Shape",
		// Humanoid model from VS Village (MIT), see THIRD_PARTY_NOTICES.md. Uses vanilla skin textures.
		"shape": { "base": "createacolony:entity/humanoid/settler-{sex}" },
		"textures": { "skin1": { "base": "game:entity/humanoid/villagerbody/skin/normal3" } },
		"behaviors": [
			{ "code": "villagerinventory" },
			{ "code": "seraphinventory" },
			{ "code": "nametag", "showtagonlywhentargeted": true },
			{ "code": "repulseagents" },
			{ "code": "controlledphysics", "stepHeight": 1.1 },
			{ "code": "interpolateposition" }
		],
		"animations": [
			{ "code": "idle", "animation": "balanced-idle", "blendMode": "average", "triggeredBy": { "defaultAnim": true } },
			{ "code": "walk", "animation": "balanced-walk", "blendMode": "average" },
			{ "code": "sleep", "animation": "balanced-lie", "blendMode": "average", "weight": 10 },
			{ "code": "shelter", "animation": "balanced-sitfloor", "blendMode": "average", "weight": 10 },
			{ "code": "eat", "animation": "balanced-holdbelly-idle", "blendMode": "average", "weight": 5 },
			{ "code": "build", "animation": "balanced-hit", "blendMode": "average", "weight": 5 },
			{ "code": "die", "animation": "balanced-die", "animationSpeed": 1.75, "weight": 10, "blendMode": "addAverage" },
			{ "code": "hurt", "animation": "balanced-hurt", "animationSpeed": 2, "blendMode": "addAverage" }
		]
	},
	"server": {
		"behaviors": [
			{ "code": "villagerinventory" },
			{ "code": "seraphinventory" },
			{ "code": "nametag", "showtagonlywhentargeted": true },
			{ "code": "repulseagents" },
			{ "code": "controlledphysics", "stepHeight": 1.1 },
			{ "code": "health", "currenthealth": 20, "maxhealth": 20 },
			{ "code": "colonycitizen" },
			{ "code": "settlerneeds" },
			{
				"code": "taskai",
				"aitasks": [
					// Highest priority wins. Job work sits between eating and wandering; each job task only runs for its own job.
					// Runs from a creature that hurt it (not guards): home or to a guard, see AiTaskSettlerFlee.
					// Armed, with no guard near: fights the creature that hurt it instead of running, see AiTaskSettlerDefend.
					{ "code": "settlerdefend", "animation": "walk", "animationSpeed": 1.4, "priority": 3.6, "movespeed": 0.03 },
					{ "code": "settlerflee", "animation": "walk", "animationSpeed": 1.6, "priority": 3.5, "movespeed": 0.034 },
					{ "code": "settlershelter", "animation": "walk", "priority": 3.0, "movespeed": 0.025 },
					{ "code": "settlersleep", "animation": "walk", "priority": 2.0, "movespeed": 0.018 },
					{ "code": "settlereat", "animation": "walk", "priority": 1.5, "movespeed": 0.02 },
					// Now and then: put up a painting, rack or shelf at home (any settler near home), see AiTaskSettlerDecorate.
					{ "code": "settlerdecorate", "animation": "walk", "priority": 1.3, "movespeed": 0.02 },
					// Settlers without a job: look after their home first, then help with hauling (settlercourier).
					{ "code": "settlerchores", "animation": "walk", "priority": 1.25, "movespeed": 0.02 },
					{ "code": "settlercourier", "animation": "walk", "priority": 1.2, "movespeed": 0.022 },
					{ "code": "settlerbuilder", "animation": "walk", "priority": 1.2, "movespeed": 0.02 },
					{ "code": "settlerforester", "animation": "walk", "priority": 1.2, "movespeed": 0.02 },
					{ "code": "settlerfarmer", "animation": "walk", "priority": 1.2, "movespeed": 0.02 },
					{ "code": "settlerpotter", "animation": "walk", "priority": 1.2, "movespeed": 0.02 },
					{ "code": "settlercook", "animation": "walk", "priority": 1.2, "movespeed": 0.02 },
					{ "code": "settlerprospector", "animation": "walk", "priority": 1.2, "movespeed": 0.02 },
					{ "code": "settlerminer", "animation": "walk", "priority": 1.2, "movespeed": 0.02 },
					{ "code": "settlerprospectorminer", "animation": "walk", "priority": 1.2, "movespeed": 0.02 },
					{ "code": "settlerquarrier", "animation": "walk", "priority": 1.2, "movespeed": 0.02 },
					{ "code": "settlersmelter", "animation": "walk", "priority": 1.2, "movespeed": 0.02 },
					{ "code": "settlerblacksmith", "animation": "walk", "priority": 1.2, "movespeed": 0.02 },
					{ "code": "settlersawyer", "animation": "walk", "priority": 1.2, "movespeed": 0.02 },
					{ "code": "settlercraftsman", "animation": "walk", "priority": 1.2, "movespeed": 0.02 },
					{ "code": "settlerexplorer", "animation": "walk", "priority": 1.2, "movespeed": 0.022 },
					{ "code": "settlergatherer", "animation": "walk", "priority": 1.2, "movespeed": 0.02 },
					{ "code": "settlerhunter", "animation": "walk", "priority": 1.2, "movespeed": 0.025 },
					{ "code": "settlerguard", "animation": "walk", "priority": 1.2, "movespeed": 0.024 },
					{ "code": "settlervisitor", "animation": "walk", "priority": 1.1, "movespeed": 0.02 },
					// Not the game's "wander": it walks straight into walls and teleports settlers back to where they spawned.
					{ "code": "settleridle", "priority": 1.0, "movespeed": 0.012, "animation": "walk", "strollRadius": 6 },
					{ "code": "lookaround", "priority": 0.5 }
				]
			}
		]
	},
	"sounds": {}
}
